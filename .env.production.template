# Node Environment
NODE_ENV=production

# Application
PORT=3000
APP_URL=http://91.98.19.163

# NextAuth Configuration
# IMPORTANT: Update these values before deploying!
NEXTAUTH_URL=http://91.98.19.163
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

# Database Configuration
# Update with your actual database credentials
DATABASE_URL=postgresql://username:password@localhost:5432/valt_intellidoc?schema=public

# Redis (if using caching)
# REDIS_URL=redis://localhost:6379

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# AI/ML API Keys
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=org-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_AI_API_KEY=...

# Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Document Storage
# AWS S3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=valt-intellidoc-docs

# Or use local storage
UPLOAD_DIR=/var/www/valt-intellidoc/uploads
MAX_FILE_SIZE=10485760

# Vector Database (for embeddings)
# PINECONE_API_KEY=...
# PINECONE_ENVIRONMENT=...
# PINECONE_INDEX=valt-intellidoc

# Or Weaviate
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=...

# Security
# JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
# ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_BYTE_HEX_STRING

# Monitoring & Logging
LOG_LEVEL=info
# SENTRY_DSN=https://...@sentry.io/...

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_DEBUG_MODE=false

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
